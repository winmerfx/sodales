# SODALES environment variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
#
# NEXT_PUBLIC_* is compiled into the browser bundle and visible to ANYONE who visits
# the site. Everything else stays on the server. Putting a secret behind a
# NEXT_PUBLIC_ prefix publishes it.
#
# Full explanation of each variable: docs/ARCHITECTURE.md section 12.

# ─── Brand ────────────────────────────────────────────────────────────────────
BRAND_NAME=SODALES
BRAND_TAGLINE=
SUPPORT_EMAIL=
DEFAULT_CURRENCY=USD

# ─── Site ─────────────────────────────────────────────────────────────────────
# SAFE TO EXPOSE. Canonical URLs, Open Graph tags, checkout redirects.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API

# SAFE TO EXPOSE. Your project's URL.
NEXT_PUBLIC_SUPABASE_URL=

# SAFE TO EXPOSE. The "anon public" key. It is designed for browsers and every
# query it makes is constrained by row-level security policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ############################################################################
# SECRET — NEVER EXPOSE. The "service_role" key bypasses ALL database security.
# Anyone holding it can read and modify every row in your database, including
# other customers' orders. Server-side only. Never in a NEXT_PUBLIC_ variable,
# never in a client component, never in a screenshot or a support ticket.
# ############################################################################
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments (Phase 5) ───────────────────────────────────────────────────────
# Provider is not final — see PROJECT_STATUS.md Open Decisions.

# SECRET. Creates checkouts and can read your store's data.
PAYMENTS_API_KEY=

# SECRET. Proves an incoming webhook genuinely came from the payment provider.
# If this leaks, someone can forge a "payment completed" event and grant
# themselves free products.
PAYMENTS_WEBHOOK_SECRET=

# Not strictly secret, but no reason to publish it.
PAYMENTS_STORE_ID=

# ─── AI providers (Phase 8) ───────────────────────────────────────────────────
# SECRET AND BILLABLE. A leaked key means someone else spends your money.
# Set a spending limit in the provider's dashboard as well.
# Only the provider you actually use needs a value.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Email (Phase 9) ──────────────────────────────────────────────────────────
# SECRET. Can send email as your verified domain — a leak enables phishing
# that appears to come from you.
RESEND_API_KEY=

# ─── Analytics (Phase 9) ──────────────────────────────────────────────────────
# SAFE TO EXPOSE. Write-only ingest key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Error monitoring (Phase 10) ──────────────────────────────────────────────
# SAFE TO EXPOSE.
SENTRY_DSN=

# ─── Admin bootstrap ──────────────────────────────────────────────────────────
# The email address promoted to admin. See docs/ROADMAP.md Phase 3.
ADMIN_EMAIL=
